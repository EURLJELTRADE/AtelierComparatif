---
import '../styles/global.css';
const {
  title = 'AtelierComparatif.fr — Guides, tests et comparatifs pour l’atelier',
  description = 'Guides, tests indépendants et comparatifs de produits pour l’entretien automobile, la mécanique et l’atelier.',
  canonical,
  image,
  type = 'website',
  jsonLd = [],
  robots = 'index,follow,max-image-preview:large'
} = Astro.props;
const canonicalUrl = canonical ? new URL(canonical, Astro.site) : new URL(Astro.url.pathname, Astro.site);
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AtelierComparatif.fr",
  "url": "https://ateliercomparatif.fr/"
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AtelierComparatif.fr",
  "url": "https://ateliercomparatif.fr/",
  "inLanguage": "fr-FR"
};
---
<!doctype html>
<html lang="fr">
<head>
  <!-- Google Tag Manager -->
  <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WM79Z4CZ');
  </script>
  <!-- End Google Tag Manager -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <meta name="theme-color" content="#10243b" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  <script type="application/ld+json" set:html={JSON.stringify(website)} />
  {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WM79Z4CZ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <header class="topbar">
    <div class="wrap nav">
      <a class="brand" href="/">Atelier<span>Comparatif</span>.fr</a>
      <nav class="links" aria-label="Navigation principale">
        <a href="/guides/">Guides</a>
        <a href="/comparatifs/">Comparatifs</a>
        <a href="/tests/">Tests</a>
        <a href="/marques/">Marques</a>
        <a href="/conseils-atelier/">Conseils atelier</a>
        <a href="/dossiers/">Dossiers</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="footer">
    <div class="wrap footer-inner">
      <div><strong>AtelierComparatif.fr</strong><br/>Guides, tests et comparatifs pour mieux choisir.</div>
      <div><a href="/a-propos/">À propos</a> · <a href="/methodologie/">Méthodologie</a> · <a href="/charte-editoriale/">Charte éditoriale</a> · <a href="/mentions-legales/">Mentions légales</a> · <a href="/contact/">Contact</a></div>
    </div>
  </footer>
</body>
</html>
