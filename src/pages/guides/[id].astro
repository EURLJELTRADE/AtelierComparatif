---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { id: guide.id },
    props: { guide }
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const allGuides = await getCollection('guides');
const allComparatifs = await getCollection('comparatifs');
const contentMap = new Map([
  ...allGuides.map((item) => ['/guides/' + item.id + '/', { title: item.data.title, excerpt: item.data.excerpt, href: '/guides/' + item.id + '/' }]),
  ...allComparatifs.map((item) => ['/comparatifs/' + item.id + '/', { title: item.data.title, excerpt: item.data.excerpt, href: '/comparatifs/' + item.id + '/' }])
]);
const explicitRelated = (guide.data.related ?? []).map((href) => contentMap.get(href)).filter(Boolean);
const fallbackRelated = allGuides
  .filter((item) => item.id !== guide.id)
  .slice(0, 3)
  .map((item) => ({ title: item.data.title, excerpt: item.data.excerpt, href: '/guides/' + item.id + '/' }));
const relatedItems = (explicitRelated.length ? explicitRelated : fallbackRelated).slice(0, 3);
const url = new URL('/guides/' + guide.id + '/', Astro.site);
const published = guide.data.date.toISOString();
const modified = (guide.data.updated ?? guide.data.date).toISOString();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'fr-FR',
  mainEntityOfPage: url.toString(),
  image: guide.data.image ? [guide.data.image] : undefined,
  publisher: {
    '@type': 'Organization',
    name: 'AtelierComparatif.fr',
    url: 'https://ateliercomparatif.fr/'
  }
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://ateliercomparatif.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://ateliercomparatif.fr/guides/' },
    { '@type': 'ListItem', position: 3, name: guide.data.title, item: url.toString() }
  ]
};
---
<BaseLayout
  title={guide.data.seoTitle ?? guide.data.title}
  description={guide.data.description}
  canonical={'/guides/' + guide.id + '/'}
  image={guide.data.image}
  type="article"
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="article-page">
    <div class="wrap article-wrap">
      <nav class="breadcrumbs" aria-label="Fil d’Ariane">
        <a href="/">Accueil</a><span>›</span><a href="/guides/">Guides</a><span>›</span><span>{guide.data.category}</span>
      </nav>

      <header class="article-header">
        <div class="section-kicker">{guide.data.category}</div>
        <h1>{guide.data.title}</h1>
        <p class="article-excerpt">{guide.data.excerpt}</p>
        <div class="article-meta">
          <span>{guide.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          <span>•</span>
          <span>{guide.data.readingTime} de lecture</span>
        </div>
      </header>

      {guide.data.image && (
        <figure class="article-cover">
          <img src={guide.data.image} alt={guide.data.imageAlt ?? guide.data.title} width="1400" height="900" />
        </figure>
      )}

      <div class="article-layout">
        <div class="article-content">
          <Content />
        </div>

        <aside class="article-toc">
          <strong>Dans ce guide</strong>
          <nav>
            {headings.filter((h) => h.depth === 2).map((h) => <a href={'#' + h.slug}>{h.text}</a>)}
          </nav>
        </aside>
      </div>

      {relatedItems.length > 0 && (
        <section class="article-related">
          <div class="section-kicker">À lire ensuite</div>
          <h2>Compléter ce guide</h2>
          <div class="article-related-grid">
            {relatedItems.map((item) => (
              <a class="article-related-card" href={item.href}>
                <strong>{item.title}</strong>
                <span>{item.excerpt}</span>
                <em>Lire →</em>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
