---
import BaseLayout from '../layouts/BaseLayout.astro';
const categories = [
  ['Nettoyants frein','Guides, tests et comparatifs pour bien choisir.','/comparatifs/'],
  ['Dégrippants','Produits multifonctions, pénétrants et antirouille.','/guides/'],
  ['Électricité','Nettoyants contacts et entretien des connexions.','/guides/'],
  ['Frein-filets','Choisir la bonne résistance et le bon usage.','/comparatifs/']
];
const features = [
  ['Guide','Nettoyant frein : lequel choisir ?','Les critères essentiels pour comparer formats, séchage, résidus et usage professionnel.','/guides/','https://images.pexels.com/photos/6870299/pexels-photo-6870299.jpeg?auto=compress&fit=crop&w=900&q=82','Mécanicien intervenant sur un disque de frein'],
  ['Guide','Nettoyant moteur : quels produits utiliser ?','Choisir un produit adapté aux pièces moteur, aux graisses et aux matériaux environnants.','/guides/','https://images.pexels.com/photos/29181490/pexels-photo-29181490/free-photo-of-mechanic-working-on-engine-in-a-workshop.jpeg?auto=compress&fit=crop&w=900&q=82','Mécanicien travaillant sur un moteur en atelier'],
  ['Conseil','Les produits indispensables dans un atelier','Construire une sélection cohérente de nettoyants, lubrifiants et consommables pour la maintenance.','/conseils-atelier/','https://images.pexels.com/photos/28641472/pexels-photo-28641472/free-photo-of-automotive-workshop-tools-and-equipment-setup.jpeg?auto=compress&fit=crop&w=900&q=82','Outillage et équipements dans un atelier automobile']
];
---
<BaseLayout
  title="AtelierComparatif.fr — Guides, tests et comparatifs pour l’atelier"
  description="Comparez les produits d’entretien automobile et d’atelier : nettoyants frein, dégrippants, nettoyants contact, frein-filets et plus encore."
  image="https://images.pexels.com/photos/3855223/pexels-photo-3855223.jpeg?auto=compress&fit=crop&w=1600&q=82"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">Le guide indépendant de l’atelier</div>
        <h1>Mieux choisir ses produits d’entretien et d’atelier.</h1>
        <p>Guides pratiques, tests, comparatifs et méthodes pour comprendre les produits techniques avant de les acheter.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/comparatifs/">Voir les comparatifs</a>
          <a class="btn btn-dark" href="/guides/">Consulter les guides</a>
        </div>
      </div>
      <aside class="hero-visual">
        <img src="https://images.pexels.com/photos/3855223/pexels-photo-3855223.jpeg?auto=compress&fit=crop&w=1200&q=82" alt="Mécanicien sélectionnant des outils dans un atelier automobile" width="1200" height="800" fetchpriority="high" />
        <div class="hero-overlay">
          <strong>Comparer avant d’acheter.</strong>
          <span>Des critères techniques expliqués simplement.</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="eyebrow">Explorer</div>
      <h2>Choisir par type de produit</h2>
      <p class="lead">AtelierComparatif organise ses contenus par usage pour construire des dossiers complets et faciles à parcourir.</p>
      <div class="category-grid">
        {categories.map(([title,desc,href]) => <a class="category" href={href}>{title}<small>{desc}</small></a>)}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:20px">
    <div class="wrap">
      <div class="eyebrow">À la une</div>
      <h2>Premiers dossiers</h2>
      <div class="grid">
        {features.map(([tag,title,text,href,img,alt]) => <article class="card editorial-card"><img class="card-image" src={img} alt={alt} width="900" height="600" loading="lazy" /><div class="card-body"><div class="tag">{tag}</div><h3>{title}</h3><p>{text}</p><a href={href} style="font-weight:800;color:var(--orange)">Découvrir →</a></div></article>)}
      </div>
    </div>
  </section>

  <section class="section method">
    <div class="wrap">
      <div class="eyebrow" style="color:var(--yellow)">Méthodologie</div>
      <h2>Un média utile avant d’être commercial.</h2>
      <p class="lead">Nos contenus distinguent les données fabricants, les critères techniques, les usages possibles et les recommandations éditoriales. Les partenariats et liens commerciaux seront signalés lorsqu’ils existent.</p>
      <div class="grid">
        <div class="card"><h3>Comprendre</h3><p>Expliquer la fonction réelle d’un produit et les contraintes de son application.</p></div>
        <div class="card"><h3>Comparer</h3><p>Mettre plusieurs solutions en regard avec des critères identiques et lisibles.</p></div>
        <div class="card"><h3>Choisir</h3><p>Orienter vers le produit adapté à l’usage plutôt que vers une marque par défaut.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
