---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  ['Nettoyants frein','/comparatifs/','https://images.pexels.com/photos/6870299/pexels-photo-6870299.jpeg?auto=compress&fit=crop&w=640&q=82','Mécanicien intervenant sur un disque et un étrier de frein'],
  ['Dégrippants','/guides/','https://images.pexels.com/photos/37241200/pexels-photo-37241200.jpeg?auto=compress&fit=crop&w=640&q=82','Boulon métallique fortement rouillé'],
  ['Électricité','/guides/','https://images.pexels.com/photos/32282232/pexels-photo-32282232.jpeg?auto=compress&fit=crop&w=640&q=82','Batterie automobile avec câbles et cosses'],
  ['Frein-filets','/comparatifs/','https://images.pexels.com/photos/9966689/pexels-photo-9966689.jpeg?auto=compress&fit=crop&w=640&q=82','Vis et boulons métalliques filetés'],
  ['Nettoyants moteur','/guides/','https://images.pexels.com/photos/7565174/pexels-photo-7565174.jpeg?auto=compress&fit=crop&w=640&q=82','Nettoyage manuel d’une pièce moteur métallique'],
  ['Antirouille','/guides/','https://images.pexels.com/photos/31840105/pexels-photo-31840105.jpeg?auto=compress&fit=crop&w=640&q=82','Surface métallique attaquée par la rouille et la corrosion']
];

const features = [
  ['GUIDE','Nettoyant frein : lequel choisir ?','Rôle, critères de choix, formats et sélection selon l’usage.','/guides/','https://images.pexels.com/photos/6870299/pexels-photo-6870299.jpeg?auto=compress&fit=crop&w=1000&q=84','Intervention sur un disque de frein'],
  ['COMPARATIF','WD-40 ou dégrippant professionnel ?','Efficacité, pénétration, protection : les critères pour faire le bon choix.','/comparatifs/','https://images.pexels.com/photos/37241200/pexels-photo-37241200.jpeg?auto=compress&fit=crop&w=1000&q=84','Boulon rouillé nécessitant un dégrippant'],
  ['CONSEIL','Nettoyant moteur : quels produits utiliser ?','Produits, méthodes et précautions pour nettoyer un moteur sans risque.','/conseils-atelier/','https://images.pexels.com/photos/7565174/pexels-photo-7565174.jpeg?auto=compress&fit=crop&w=1000&q=84','Nettoyage d’une pièce moteur avec un chiffon']
];

const brands = ['GRAFEN','WD-40','Bardahl','Würth','Motul','Liqui Moly','CRC','Loctite'];
---
<BaseLayout
  title="AtelierComparatif.fr — Guides, tests et comparatifs pour l’atelier"
  description="Comparez les produits d’entretien automobile et d’atelier : nettoyants frein, dégrippants, nettoyants contact, frein-filets et plus encore."
  image="https://images.pexels.com/photos/3855223/pexels-photo-3855223.jpeg?auto=compress&fit=crop&w=1600&q=84"
>
  <section class="home-hero">
    <img class="home-hero-bg" src="https://images.pexels.com/photos/3855223/pexels-photo-3855223.jpeg?auto=compress&fit=crop&w=1800&q=84" alt="" width="1800" height="1100" fetchpriority="high" />
    <div class="home-hero-shade"></div>
    <div class="wrap home-hero-content">
      <div class="hero-copy">
        <div class="eyebrow light">Le média indépendant de l’atelier</div>
        <h1>Mieux choisir ses produits <span>d’entretien et d’atelier</span></h1>
        <p>Guides, comparatifs, tests et conseils indépendants pour sélectionner les bons produits d’entretien, de maintenance et de réparation automobile.</p>
        <div class="actions">
          <a class="btn btn-orange" href="/comparatifs/">Voir les comparatifs →</a>
          <a class="btn btn-outline" href="/guides/">Consulter les guides</a>
        </div>
        <div class="trust-row">
          <span>◉ Analyses indépendantes</span>
          <span>◫ Comparatifs structurés</span>
          <span>⚙ Conseils pratiques</span>
        </div>
      </div>
      <div class="hero-stamp">Comparer<br/>avant<br/>d’acheter</div>
    </div>
  </section>

  <section class="home-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-kicker">Explorer</div>
          <h2>Nos grands thèmes</h2>
          <p>Explorez nos dossiers et comparatifs par famille de produits.</p>
        </div>
      </div>
      <div class="theme-grid">
        {categories.map(([title,href,img,alt]) => (
          <a class="theme-card" href={href}>
            <img src={img} alt={alt} width="640" height="420" loading="lazy" />
            <div class="theme-card-body"><strong>{title}</strong><span>→</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section home-section-tight">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-kicker">À la une</div>
          <h2>Nos derniers guides et comparatifs</h2>
          <p>Des contenus conçus pour vous aider à faire un choix éclairé.</p>
        </div>
      </div>
      <div class="feature-grid">
        {features.map(([tag,title,text,href,img,alt]) => (
          <article class="feature-card">
            <div class="feature-image">
              <img src={img} alt={alt} width="1000" height="650" loading="lazy" />
              <span>{tag}</span>
            </div>
            <div class="feature-body">
              <h3>{title}</h3>
              <p>{text}</p>
              <div class="feature-footer"><small>7–10 min de lecture</small><a href={href}>→</a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section comparator-section">
    <div class="wrap comparator-shell">
      <div class="comparator-visual">
        <img src="https://images.pexels.com/photos/4489732/pexels-photo-4489732.jpeg?auto=compress&fit=crop&w=900&q=82" alt="Aérosols et produits d’entretien en atelier" width="900" height="900" loading="lazy" />
      </div>
      <div class="comparator-content">
        <div class="section-kicker">Comparer rapidement</div>
        <h2>Comparez les produits en un coup d’œil</h2>
        <p>Des tableaux simples, des critères concrets et une lecture rapide pour distinguer les produits selon leur usage.</p>
        <div class="fake-filters">
          <span>Catégorie : Nettoyant frein</span>
          <span>Usage : Tous</span>
          <span>Format : Tous</span>
        </div>
        <div class="compare-table" role="table" aria-label="Exemple de tableau comparatif">
          <div class="compare-row compare-head" role="row"><span>Produit</span><span>Usage</span><span>Format</span><span>Séchage</span><span>Résidus</span></div>
          <div class="compare-row" role="row"><span>Produit A</span><span>Freinage</span><span>500 ml</span><span>Très rapide</span><span>Aucun</span></div>
          <div class="compare-row" role="row"><span>Produit B</span><span>Métaux</span><span>500 ml</span><span>Rapide</span><span>Faibles</span></div>
          <div class="compare-row" role="row"><span>Produit C</span><span>Freinage intensif</span><span>750 ml</span><span>Très rapide</span><span>Aucun</span></div>
        </div>
        <a class="text-link" href="/comparatifs/">Découvrir les comparatifs →</a>
      </div>
    </div>
  </section>

  <section class="home-section method-light">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-kicker">Notre démarche</div>
          <h2>Un média indépendant et exigeant</h2>
          <p>Des contenus utiles, transparents et construits autour de critères vérifiables.</p>
        </div>
      </div>
      <div class="method-grid">
        <div class="method-box"><div class="method-icon">01</div><h3>Comprendre</h3><p>Expliquer les produits, leurs usages, leurs limites et les précautions à connaître.</p></div>
        <div class="method-box"><div class="method-icon">02</div><h3>Comparer</h3><p>Mettre plusieurs solutions en regard avec des critères identiques et lisibles.</p></div>
        <div class="method-box"><div class="method-icon">03</div><h3>Choisir</h3><p>Orienter vers le produit adapté au besoin plutôt que vers une marque par défaut.</p></div>
      </div>
    </div>
  </section>

  <section class="home-section brands-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-kicker">Marques</div>
          <h2>Les marques que nous analysons</h2>
          <p>Nous testons et comparons les références de nombreux fabricants reconnus.</p>
        </div>
      </div>
      <div class="brand-grid">
        {brands.map((brand) => <a href="/marques/">{brand}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>
